# Database connection string for PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailbox_order_db?schema=public"

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mailbox_order_db
POSTGRES_PORT=5432

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
SESSION_SECRET="mailbox-order-manager-super-secret-key-at-least-32-chars-long"

# Background Worker Settings
WORKER_POLL_INTERVAL_MS=2000
PROVIDER_FAILURE_RATE=0.20
PROVIDER_BASE_DELAY_MS=1500

